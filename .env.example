# Anthropic API key used to generate AI scouting reports (server-side only)
ANTHROPIC_API_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Self-serve admin grant secret used at /admin/setup.
# Set this to a private value only you know, then visit /admin/setup while
# signed in and enter it once to promote your account to admin.
ADMIN_SETUP_SECRET=

# Supabase project URL and publishable (anon) key.
# Get these at https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
